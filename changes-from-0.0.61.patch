+  vec3 c = loadEasu(fPosition + ivec2( 1, -1));
+  vec3 e = loadEasu(fPosition + ivec2(-1,  0));
+  vec3 f = loadEasu(fPosition + ivec2( 0,  0));
+  vec3 g = loadEasu(fPosition + ivec2( 1,  0));

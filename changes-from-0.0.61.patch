+  bool compare = u_compare > 0.5;
+  if (compare && abs(v_uv.x - 0.5) < 1.5 * u_texel.x) {
+    outColor = vec4(0.0, 1.0, 0.53, 1.0);
+    return;
+  }
+  if (u_strength <= 0.0 || (compare && v_uv.x < 0.5)) {
+    outColor = vec4(texture(u_tex, v_uv).rgb, 1.0);
+    return;
+  }
+  outColor = vec4(rcas(v_uv), 1.0);
+}`;
